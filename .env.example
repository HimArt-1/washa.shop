# ─── نسخ هذا الملف إلى .env.local وملء القيم. لا ترفع .env.local إلى Git. ───

# Clerk (المصادقة)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
# Clerk Webhook — مزامنة المستخدمين مع Supabase (من لوحة Clerk → Webhooks)
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxx

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx

# توليد الصور (أداة التصميم) — خيارات المزوّد: nanobanana (Gemini 3 Flash), replicate (Flux), gemini (Imagen 3)
# اختياري: تحديد المزوّد. الافتراضي nanobanana إذا توفر GEMINI_API_KEY
IMAGE_PROVIDER=nanobanana

# WASHA AI (DTF) — اختياري. إن لُم يُضبط: يُستخدم IMAGE_PROVIDER وإن كان فارغاً يُلجأ لـ genai
# بوابة إنتاجية fail-closed: لا يعمل التوليد في production إلا بعد ضبطها true واختبار المزوّد فعلياً.
WASHA_DTF_GENERATION_ENABLED=false
# WASHA_DTF_IMAGE_PROVIDER=genai
# WASHA_DTF_IMAGE_PROVIDER=replicate
# WASHA_DTF_IMAGE_PROVIDER=nanobanana
# WASHA_DTF_IMAGE_PROVIDER=gemini
# أصل التصميم الشفاف في WASHA AI يستخدم GPT Image الموجود في المشروع لأن
# المسار يطلب Alpha حقيقية عبر API، لا إزالة خلفية لاحقة.
OPENAI_API_KEY=sk-xxxx
OPENAI_IMAGE_MODEL=gpt-image-1
WASHA_DTF_ARABIC_VERIFICATION_MODEL=gpt-4o-mini
WASHA_DTF_GARMENT_VERIFICATION_MODEL=gpt-4o-mini
WASHA_ARTWORK_OPENAI_SIZE=1024x1536
# الحد الأدنى لقبول design-master.png
WASHA_DTF_MIN_ARTWORK_DIMENSION=1024
# الحد الأدنى للدقة الفعلية عند المقاس المختار، قبل أي تكبير إنتاجي.
WASHA_DTF_MIN_EFFECTIVE_DPI=85
# دقة موكب القطعة الفارغة عند استخدام Gemini 3
WASHA_DTF_GARMENT_IMAGE_SIZE=2K
WASHA_DTF_MIN_MOCKUP_DIMENSION=512
WASHA_DTF_MIN_GARMENT_PRINT_AREA_ENTROPY=0.15
WASHA_DTF_MAX_GARMENT_COLOR_DISTANCE=170
# Phase 0: كلا التغييرين السلوكيين مغلق افتراضيًا للحفاظ على السلوك القديم.
WASHA_ENABLE_TOLERANT_TEXT_MATCH=false
WASHA_PROMPT_GUARD_ENABLED=false
# Phase 3: Structured Public Errors + User Actions مغلق افتراضيًا.
WASHA_STRUCTURED_USER_ACTIONS_ENABLED=false
# Phase 3b: لا retry آلي قبل اعتماد ضمان إعادة استخدام الحصة.
WASHA_ENABLE_AUTO_RETRY_QUOTA_SAFE=false
# توافق طارئ فقط للعمليات القديمة؛ اتركه false في المسار الطبيعي.
WASHA_DTF_LEGACY_EXTRACTION_ENABLED=false
# نموذج توليد الصور داخل DTF (مسار @google/genai) — اختياري:
# WASHA_DTF_GENAI_MODEL=gemini-3.1-flash-image-preview
# للرجوع للجيل السابق: WASHA_DTF_GENAI_MODEL=gemini-2.5-flash-image
# إن استُخدمت واجهة :predict (nanobanana في أداة التصميم) فقط:
# NANO_BANANA_PREDICT_MODEL=imagen-4.0-ultra-generate-001

# Gemini (Nano Banana / Imagen)
GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxxx

# Replicate (Flux)
REPLICATE_API_TOKEN=r8_xxxx

# Resend (البريد الإلكتروني)
# RESEND_API_KEY=re_xxxx
# EMAIL_FROM=وشّى <noreply@yourdomain.com>

# إشعارات الأدمن بالبريد (طلبات، انضمام، تسجيل حسابات، تسجيل دخول)
# عدة مستلمين مفصولين بفواصل. إذا تُرك فارغاً يستخدم ADMIN_EMAIL.
# ADMIN_EMAILS=orders@yourdomain.com,ops@yourdomain.com,admin@yourdomain.com
# ADMIN_EMAIL=admin@yourdomain.com

# بوت تنبيهات الأدمن التشغيلية (Telegram / Discord)
# يكفي تفعيل Telegram أو Discord. Telegram يتطلب القيمتين معاً.
# TELEGRAM_BOT_TOKEN=123456789:xxxx
# TELEGRAM_CHAT_ID=-1001234567890
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# Web Push (إشعارات المتصفح). توليد المفاتيح: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=xxxx
# VAPID_PRIVATE_KEY=xxxx
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxx  (نفس القيمة العامة)

# Stripe (الدفع الإلكتروني — Visa, Mada, Apple Pay)
# STRIPE_SECRET_KEY=sk_test_xxxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Tap Payments (بوابة الدفع الأساسية — لا تضع مفاتيح الإنتاج في Git)
# TAP_SECRET_KEY=sk_test_xxxx
# TAP_MERCHANT_ID=merchant_id_from_tap_dashboard
# NEXT_PUBLIC_TAP_PUBLIC_KEY=pk_test_xxxx
# TAP_CHECKOUT_ENABLED=false  # غيّرها إلى true بعد اكتمال تفعيل الحساب واختبار Sandbox
# LEGACY_PAYMENT_CREATION_ENABLED=false  # اتركه false؛ Webhooks القديمة تبقى للاستقبال فقط

# التحويل البنكي (اختياري — يظهر في Checkout عند تعبئته)
# BANK_TRANSFER_BANK_NAME=اسم البنك
# BANK_TRANSFER_ACCOUNT_NAME=اسم صاحب الحساب
# BANK_TRANSFER_IBAN=SA0000000000000000000000

# Torod (الشحن والـ Webhook)
# TOROD_CLIENT_ID=torod_client_id
# TOROD_CLIENT_SECRET=torod_client_secret
# TOROD_WEBHOOK_SECRET=torod_webhook_secret_optional_if_different
# TOROD_API_URL=https://torod.co/en/api
# Sandbox:
# TOROD_API_URL=https://demo.stage.torod.co/en/api
# Optional: enables automatic order/ship/process after order/create
# TOROD_WAREHOUSE=warehouse_no_from_address_list
# TOROD_COURIER_PARTNER_ID=courier_partner_id
# TOROD_SHIPMENT_TYPE=normal
# TOROD_IS_OWN=0
# TOROD_INSURANCE=0

# Seed (للإنتاج فقط — حماية مسار /api/seed)
# SEED_SECRET=your-random-secret-here

# عنوان الموقع (للروابط في البريد، Stripe، إلخ)
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
